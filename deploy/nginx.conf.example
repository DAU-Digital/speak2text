# /etc/nginx/sites-available/phude — điền server_name rồi chạy: sudo certbot --nginx -d <subdomain>
server {
    listen 80;
    server_name _;  # TODO: subdomain của anh, ví dụ phude.example.com

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;   # server dùng IP này để khoá đoán passcode
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
# Micro chỉ chạy trên HTTPS: certbot sẽ thêm khối listen 443 ssl và redirect 80 → 443.
